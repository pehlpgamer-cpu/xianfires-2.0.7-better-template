{
  "name": "xianfires-2.0.7-better-template",
  "version": "1.0.0",
  "description": "XianFire Framework project",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node ./src/app.js",
    "xian": "nodemon ./src/app.js",
    "migrate": "node ./src/scripts/migrate/migrate.js",
    "migrate:fresh": "node ./src/scripts/migrate/fresh.js",
    "migrate:drop": "node ./src/scripts/migrate/drop.js",
    "create:model": "node ./src/scripts/create/index.js model",
    "create:controller": "node ./src/scripts/create/index.js controller",
    "route:list": "node ./src/scripts/list-routes.js",
    "route:cache": "node ./src/scripts/route-cache.js",
    "electron": "electron .",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "electron-builder",
    "run": "concurrently \"nodemon index.js\" \"electron .\"",
    "dist": "electron-builder --publish=never",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node bin/test.js; npm run test:dep",
    "test:dep": "test:dep:quick; test:dep:html, test:dep:matrix",
    "test:dep:quick": "npx dependency-cruiser app database routes tests config src",
    "test:dep:report": "npx dependency-cruiser --config --output-type err-html -f dependency-report.html app database routes tests config src",
    "test:dep:matrix": "npx dependency-cruiser -T html -f dependency-matrix.html app database routes tests config src"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcrypt": "^5.1.0",
    "chokidar": "^5.0.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "inquirer": "^9.2.15",
    "mysql2": "^3.24.4",
    "sequelize": "^6.37.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/expect": "^3.0.7",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@japa/snapshot": "^2.0.10",
    "concurrently": "^8.2.2",
    "dependency-cruiser": "^17.4.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.xianfire.app",
    "productName": "xianfires-2.0.7-better-template",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  }
}
