{
  "name": "xianfires-2.0.7-better-template",
  "version": "1.0.0",
  "description": "XianFire Framework project",
  "main": "electron/main.js",
  "type": "module",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "scripts": {
    "start": "node index.js",
    "xian": "nodemon index.js",
    "migrate": "node migrate.js",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "route:list": "node list-routes.js",
    "route:cache": "node route-cache.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "electron": "electron .",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "electron-builder",
    "run": "concurrently \"nodemon index.js\" \"electron .\"",
    "dist": "electron-builder --publish=never"
  },
  "dependencies": {
    "express": "^4.19.2",
    "inquirer": "^9.2.15",
    "bcrypt": "^5.1.0",
    "express-session": "^1.17.3",
    "connect-flash": "^0.1.1",
    "hbs": "^4.2.0",
    "mysql2": "^3.9.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.xianfire.app",
    "productName": "xianfires-2.0.7-better-template",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  }
}