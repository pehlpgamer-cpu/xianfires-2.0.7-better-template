        </button>
        <button class="flex gap-1 p-1 bg-yellow-200">
            <div>Edit</div>
        </button>
        {{else}} -->
        <button class="flex gap-1 p-1 bg-indigo-200">
            <i class="bi bi-cart4"></i>
            <div>Add to cart</div>
        </button>
        <!-- {{/if}} -->
    </div>
</article>