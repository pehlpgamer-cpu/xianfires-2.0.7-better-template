<article class="bg-purple-400 rounded-md p-2 flex flex-col h-64">
    <div class="flex-1 bg-gray-300 rounded-md">
    </div>
    <div class="flex-1 p-1 flex flex-col justify-center">
        <h1 class="text-lg">{{name}}</h1>
        <div>Price: {{price}}</div>
        <!-- {{#if isUserAdmin}}
        <button class="flex gap-1 p-1 bg-red-200">
