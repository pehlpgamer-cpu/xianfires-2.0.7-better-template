{{>head}}

<body class="bg-gray-50 flex flex-col h-screen">
    <nav class="bg-default border-b-1 p-2 gap-2 flex">
        <a href="/" class="font-bold flex items-center text-3xl hover:scale-106 duration-150 cursor-pointer">
            <i class="bi bi-fire text-red-600 text-xxl"></i>
            <div>
                XIANFIRE
            </div>
        </a>
        <div class="flex-1"></div>
        <div class="flex gap-2">
            <a href="/" class="btn">Home</a>
            <a href="/login-page" class="btn">Login</a>
            <a href="/register-page" class="btn">Register</a>
            <a href="/users" class="btn">Users</a>
        </div>
    </nav>
    <main>
        {{{body}}}
    </main>
    <div class="flex-1"></div>
    {{>footer}}
</body>
</html>

<style type="text/tailwindcss"> 
/* idk if this the right way to do css "import" */
{{>css/base}} 
.btn {
    @apply cursor-pointer rounded p-2 bg-red-300 hover:scale-105 hover:bg-black hover:text-white duration-150
} 
</style>